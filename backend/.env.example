# Database config
DATABASE_URL=postgresql+asyncpg://wexa_user:wexa_password@localhost:5433/wexa_db

# Redis / Celery config
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=my_super_secret_jwt_key_that_should_be_changed_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# App settings
ENVIRONMENT=development